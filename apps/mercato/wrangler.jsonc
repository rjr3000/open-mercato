{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mercato",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "c396c6d0002b4cc28e5557e08181a25a",
      "localConnectionString": "postgresql://postgres:postgres@localhost:5432/postgres"
    }
  ],
  "observability": { "enabled": true },
  "vars": {
    "APP_URL": "https://mercato.rg1.in",
    "NEXT_PUBLIC_APP_URL": "https://mercato.rg1.in",
    "PLATFORM_PORTAL_BASE_URL": "https://mercato.rg1.in",
    "DEMO_MODE": "false",
    "QUEUE_STRATEGY": "local",
    "QUEUE_BASE_DIR": "/tmp/om-queue",
    "OM_EVENTS_SINGLE_DELIVERY": "false",
    "DB_POOL_MIN": "0",
    "DB_POOL_MAX": "5",
    "DB_POOL_ACQUIRE_TIMEOUT": "10000",
    "OM_LOG_LEVEL": "info"
  }
}
